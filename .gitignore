# 本地运行产物与备份，不入库
__pycache__/
*.pyc
*.orig-v0.2
*.log

# 实验/验收运行现场（每次跑都会重生，含临时 token 与账本）
prototype/.lab-tokens/
prototype/data/
prototype/evidence/
prototype/logs/
prototype/runtime/
adapters/verification-seat/.lab-tokens/
adapters/verification-seat/data/
adapters/verification-seat/evidence/
adapters/verification-seat/fixtures/
adapters/verification-seat/logs/
adapters/verification-seat/runtime/

# 复跑产物
rerun-*.json

# lab 运行时 pid/端口（每次 start 重生）
bench/.lab-pids.json

# 受控实验的临时工作目录（题目在这里执行，每次重生）
bench/controlled_experiment/raw/_work/

# 与远端同步用的本地副本目录
stage2-remote/
