{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:universal-agent-interface:envelope:v1",
  "title": "Universal Agent Interface Task Envelope v1",
  "description": "Canonical task submission envelope. Serialized envelopes must not exceed 262144 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "envelope_id",
    "task_id",
    "idempotency_key",
    "target",
    "instruction",
    "timeout_s",
    "cls",
    "created_by",
    "created_at",
    "trace_id"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "envelope_id": {
      "$ref": "#/$defs/uuid"
    },
    "task_id": {
      "$ref": "#/$defs/uuid"
    },
    "context_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "A2A Task.contextId 的对应字段：同一会话上下文内的多轮任务共享此值。v1.1 新增（A-06）。"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "interface_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "oneOf": [
        {
          "required": [
            "interface_id"
          ]
        },
        {
          "required": [
            "capability"
          ]
        }
      ]
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 262144
    },
    "skill_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      ]
    },
    "resource_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "params": {
      "type": [
        "object",
        "null"
      ]
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactPointer"
      }
    },
    "timeout_s": {
      "type": "integer",
      "minimum": 1
    },
    "cls": {
      "enum": [
        "readonly",
        "reversible",
        "external"
      ]
    },
    "priority": {
      "enum": [
        "high",
        "standard",
        "low"
      ],
      "default": "standard"
    },
    "approval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/approvalCredential"
        }
      ]
    },
    "created_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "$ref": "#/$defs/uuid"
    },
    "sla": {
      "$ref": "#/$defs/sla"
    },
    "billing": {
      "$ref": "#/$defs/billing"
    },
    "residency": {
      "$ref": "#/$defs/residency"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "cls"
        ],
        "properties": {
          "cls": {
            "const": "external"
          }
        }
      },
      "then": {
        "required": [
          "approval"
        ],
        "properties": {
          "approval": {
            "$ref": "#/$defs/approvalCredential"
          }
        }
      },
      "else": {
        "properties": {
          "approval": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256",
        "bytes",
        "media_type"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/]+/[^/]+$"
        },
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ],
          "description": "数据分级（B-04）。v1.2 修正：此前写在 items 的 $ref 兄弟位，被 artifactPointer 的 additionalProperties:false 拒收，等于该字段从未可用。"
        }
      }
    },
    "sla": {
      "type": "object",
      "additionalProperties": false,
      "description": "对外承诺（§13.1）。只描述承诺，不描述惩罚与判定。",
      "properties": {
        "response_within_s": {
          "type": "integer",
          "minimum": 0
        },
        "deadline_at": {
          "type": "string",
          "format": "date-time"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "description": "计费声明（§13.2）。unit_price=null 表示未定价，不得推断为 0。",
      "required": [
        "basis"
      ],
      "properties": {
        "basis": {
          "enum": [
            "per_task",
            "per_token",
            "per_minute"
          ]
        },
        "unit_price": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "settle_to": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "settlement_disputed": {
          "type": "boolean"
        }
      }
    },
    "residency": {
      "type": "object",
      "additionalProperties": false,
      "description": "数据驻留声明（§13.3）。may_leave 缺省按 false 处理。",
      "properties": {
        "store_in": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "minItems": 1
        },
        "may_leave": {
          "type": "boolean",
          "default": false
        },
        "retention_days": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "approvalCredential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_id",
        "approval_record_id",
        "task_id",
        "envelope_sha256",
        "approver_role",
        "decision",
        "decided_at",
        "expires_at",
        "single_use"
      ],
      "properties": {
        "credential_id": {
          "$ref": "#/$defs/uuid"
        },
        "approval_record_id": {
          "$ref": "#/$defs/uuid"
        },
        "task_id": {
          "$ref": "#/$defs/uuid"
        },
        "envelope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "approver_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "decision": {
          "const": "approved"
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "single_use": {
          "const": true
        }
      }
    }
  }
}